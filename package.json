{
  "name": "frontend-computer-science",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.ts\" \"vite.config.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"vite.config.ts\" --fix",
    "format": "prettier -w .",
    "test:03-bcd": "tsx src/modules/solutions/bcd/bcd.test.ts",
    "test:04-bit-ops": "tsx src/modules/solutions/bit-ops/cyclic-shift.test.ts",
    "test:05-pixel-stream": "tsx src/modules/solutions/pixel-stream/arrays/pixel-stream.contract.test.ts",
    "test:06-arrays": "tsx src/modules/solutions/arrays/circular-buffer.test.ts",
    "test:07-utf8-strings:basic": "tsx src/modules/solutions/utf8-strings/utf8-strings-basic.test.ts",
    "test:07-utf8-strings:pointers": "tsx src/modules/solutions/utf8-strings/utf8-strings-pointers.test.ts",
    "test:07-utf8-strings": "npm run test:07-utf8-strings:basic && npm run test:07-utf8-strings:pointers",
    "test:08-data-formats": "tsx src/modules/solutions/data-formats/csv-parser.test.ts",
    "test:09-matrix2d": "tsx src/modules/solutions/matrix-vector/matrix2d.test.ts",
    "test:09-vector": "tsx src/modules/solutions/matrix-vector/vector.test.ts",
    "test:09-rgba-view": "tsx src/modules/solutions/matrix-vector/rgba-view.test.ts",
    "test:09-matrix-vector": "npm run test:09-matrix2d && npm run test:09-vector && npm run test:09-rgba-view",
    "test:10-stack-queue": "tsx src/modules/solutions/stack-queue/dequeue.test.ts",
    "test:11-memory-manager": "tsx src/modules/solutions/memory-manager/memory.test.ts",
    "test:12-os-memory": "tsx src/modules/solutions/os-memory/memory.test.ts",
    "test:13-hash-table": "tsx src/modules/solutions/hash-table/hash-table.test.ts",
    "test:14-sorting-search": "tsx src/modules/solutions/sorting-search/sorted-array.test.ts",
    "test:15-graph": "tsx src/modules/solutions/graph/matrix-graph.test.ts",
    "test:20-regular-expressions": "tsx src/modules/solutions/regular-expressions/regular-expressions.test.ts",
    "test:21-advanced-regular-expressions": "tsx src/modules/solutions/advanced-regular-expressions/advanced-regular-expressions.test.ts",
    "test:22-lookahead-lookbehind-regex": "tsx src/modules/solutions/lookahead-lookbehind-regex/lookahead-lookbehind-regex.test.ts",
    "bench:05-pixel-stream": "tsx src/modules/solutions/pixel-stream/benchmark.ts",
    "bench:05-pixel-stream:jitless": "node --jitless ./node_modules/.bin/tsx src/modules/solutions/pixel-stream/benchmark.ts",
    "bench:06-arrays": "tsx src/modules/solutions/arrays/benchmark.ts",
    "bench:06-circular-buffer": "tsx src/modules/solutions/arrays/circular-buffer-benchmark.ts",
    "bench:07-utf8-strings": "node --expose-gc --import tsx src/modules/solutions/utf8-strings/benchmark.ts",
    "bench:08-data-formats": "node --expose-gc --import tsx src/modules/solutions/data-formats/benchmark.ts",
    "bench:09-matrix": "tsx src/modules/solutions/matrix-vector/matrix-benchmark.ts",
    "bench:09-vector": "node --expose-gc --import tsx src/modules/solutions/matrix-vector/vector-benchmark.ts",
    "bench:09-matrix-vector": "npm run bench:09-matrix && npm run bench:09-vector",
    "bench:10-stack-queue": "tsx src/modules/solutions/stack-queue/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.4.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^8.0.1",
    "vite-plugin-typescript-transform": "^1.3.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "brotli-wasm": "^3.0.1",
    "fflate": "^0.8.2",
    "marked": "^12.0.2",
    "msgpackr": "^1.11.10",
    "prismjs": "^1.30.0"
  }
}
